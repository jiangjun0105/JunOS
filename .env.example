# Copy to `.env.local` and fill in. Nothing here is secret except RESEND_API_KEY.

# ---- Email app (src/app/api/email/route.ts) ----
# Resend API key used to deliver the contact form. Server-side only.
RESEND_API_KEY=

# ---- Call Me app (src/components/windows/SupportWindow.tsx) ----
# ElevenLabs Conversational AI agent id for "AI Jun". Public by design: it only
# names which (public) agent to call. Without it the Call Me window renders the
# intro card and says the agent isn't configured.
# Provisioned by `node --env-file=.env scripts/provision-agent.mjs` (run
# scripts/build-agent-bundle.mjs first) — that script creates the agent, uploads
# the knowledge base and sets the post-call data-collection fields, then prints
# the id to paste here. Re-run it after editing kb/refined/ to resync.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# ---- ElevenLabs API key (server/CLI only; never exposed to the browser) ----
# Used by scripts/provision-agent.mjs. Not needed to run the site.
ELEVENLABS_API_KEY=

# ---- Site metadata (canonical URLs, sitemap, Open Graph) ----
# Defaults to https://junbot.dev when unset.
NEXT_PUBLIC_SITE_URL=
